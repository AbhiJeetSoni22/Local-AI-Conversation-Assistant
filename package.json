{
  "name": "local-ai-conversation-assistant",
  "version": "0.1.0",
  "description": "Free, privacy-first Windows desktop conversation assistant running local Whisper.cpp STT and Ollama LLM",
  "author": "Abhijeet Soni",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "preview": "vite preview",
    "validate:whisper": "tsx scripts/validate-whisper.ts",
    "test:whisper": "tsx scripts/test-whisper-failures.ts",
    "validate:ollama": "tsx scripts/validate-ollama.ts",
    "test:ollama": "tsx scripts/test-ollama.ts",
    "test:audio": "tsx scripts/test-phase4-audio.ts",
    "test:accuracy": "tsx scripts/test-transcription-accuracy.ts",
    "test:pipeline": "tsx scripts/test-pipeline-regression.ts",
    "test:phase5": "tsx scripts/test-phase5-stabilization.ts",
    "analyze:resampler": "tsx scripts/analyze-resampler.ts",
    "diagnose:whisper": "tsx scripts/diagnose-whisper.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^1.2.0"
  }
}
